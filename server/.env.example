# Server Port
PORT=5001

# Allowed Client Origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Atlas URI or local). If blank or unreachable, falls back to in-memory MongoDB.
MONGODB_URI=mongodb://127.0.0.1:27017/rating-analyzer

# Google Gemini API Key for deep LLM analysis (optional - if omitted, app works with rule-based classification)
GEMINI_API_KEY=

# Gemini Model Name (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
